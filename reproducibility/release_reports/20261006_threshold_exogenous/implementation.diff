+
+def _needs_bibliography(text: str) -> bool:
+    return bool(_citation_keys(text) or '\\printbibliography' in _active_tex(text))
+
+
+def _document_jobs(texts: dict[str, str]) -> list[list[str]]:
+    """旧补充稿两遍 XeLaTeX；含独立文献的补充稿与正文均执行完整链。"""
