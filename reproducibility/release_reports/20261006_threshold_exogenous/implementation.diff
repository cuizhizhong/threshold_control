+def _active_tex(text: str) -> str:
+    """引用和出版指令只检查未注释的源码。"""
+    return re.sub(r'(?m)(?<!\\)%.*$', '', text)
+
+
+def _citation_keys(text: str) -> set[str]:
+    return {key.strip() for group in re.findall(
