+
+def _table_bodies(text: str) -> list[str]:
+    pattern = r"\\begin\{(?P<kind>tabular|tabularx|tabular\*)\}.*?\\end\{(?P=kind)\}"
+    return [match.group() for match in re.finditer(pattern, text, re.S)]
