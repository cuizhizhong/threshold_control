*.fls
*.fdb_latexmk
*.xdv
*.synctex.gz
*.synctex.gz.sum.synctex
*.synctex

# LaTeX biber 书目产物（由 biber 重新生成）
*.bbl
*.blg

# Python 字节码缓存
__pycache__/
*.pyc

# 冻结来源须完整保存，否则 MANIFEST_SHA256.json 无法在克隆后校验。
!joint_control/threshold_control_reproducible_release_20261002/**

# 已汇集的验收日志属于交付证据，不是待清理的临时编译产物。
!reproducibility/release_reports/**/*.log

